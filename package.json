{
  "name": "@einfachllm/dsh-pomodoro-timer",
  "version": "1.2.0",
  "description": "Pomodoro focus timer for the DeepSeek Harness composer dock: tracking, settings, phase-change signals, and agent tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einfachllm/dsh-pomodoro-timer.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
